    "@ddtcorex/dsh-maestro-remote": "workspace:^0.1.0",
    "@ddtcorex/dsh-maestro-review": "workspace:^0.1.2",
    "@ddtcorex/dsh-maestro-govard": "workspace:^0.1.0",
    "@ddtcorex/dsh-maestro-memory": "workspace:^1.2.0",
    "@ddtcorex/dsh-maestro-mobile": "workspace:^1.2.0",
    "@ddtcorex/dsh-maestro-notifier": "workspace:^0.1.0",
    "@ddtcorex/dsh-maestro-config": "workspace:^0.2.0",
    "@ddtcorex/dsh-maestro-devkit": "workspace:^0.3.0",
    "@ddtcorex/dsh-maestro-sync": "workspace:^0.1.0",
    "@ddtcorex/maestro-skills": "workspace:^2.7.0"
